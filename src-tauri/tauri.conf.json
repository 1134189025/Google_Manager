{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GoogleManager",
  "version": "0.1.0",
  "identifier": "com.googlemanager.app",
  "build": {
    "frontendDist": "../static",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd frontend && pnpm run dev",
    "beforeBuildCommand": "cd frontend && pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Google 账号管理器",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
