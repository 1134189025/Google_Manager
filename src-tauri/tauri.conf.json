{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GoogleManager",
  "version": "0.3.1",
  "identifier": "com.googlemanager.app",
  "build": {
    "frontendDist": "../static",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "cd frontend && pnpm run dev",
    "beforeBuildCommand": "cd frontend && pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Google 账号管理器",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3ODgwMkQzQkU5M0QzRDkKUldUWjA1Tyswd0tJTjJtZkFxZWoydVZKanBkUkxYYmZtWTlnWFNzNzhNck9MMHNuN3NzTjBvRUUK",
      "endpoints": [
        "https://github.com/1134189025/Google_Manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
